# ==============================================================================
# CyberGuard Password Security Suite - Environment Configuration Template
# Copy this file to '.env' and update the values for your environment.
# ==============================================================================

# Flask Environment Mode
# Options: development, production
FLASK_ENV=production

# Flask Debug Mode
# WARNING: Always set to 'False' or '0' in production environments!
FLASK_DEBUG=False

# Cryptographic Secret Key
# Used for securely signing session cookies, flashes, and cryptographic state.
# In production, generate a secure random 64-character hex key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production

# Database Connection URI
# Local development default: SQLite database file (passwords.db)
#   sqlite:///passwords.db
# Production (Render / PostgreSQL):
#   postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=sqlite:///passwords.db

# Server Port (Render sets this automatically via its environment)
PORT=5000

# Python Runtime Configuration
# Ensures stdout and stderr streams are sent straight to terminal/logs without buffering
PYTHONUNBUFFERED=1
